# Google Gemini API (free tier - get key at https://aistudio.google.com)
GOOGLE_API_KEY=your-google-api-key

# Keep this stable in production so logins survive Render restarts
JWT_SECRET=change-me-to-a-long-random-string

# Database
# SQLite file path (DATABASE_URL is not consumed by this backend)
DATABASE_PATH=data/code_mentor.db
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Server
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Set to true only when SMTP below is working. If unset, verification
# is required only when all SMTP_* variables are present.
REQUIRE_EMAIL_VERIFICATION=false

# Email verification (optional for local/demo; required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional persistent database for free Render hosting.
# turso:// selects the Turso SDK; libsql:// selects the legacy libSQL SDK.
# Keep the token in hosting secrets; do not rewrite the URL scheme.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set true on free Render after adding both Turso variables.
REQUIRE_REMOTE_DATABASE=false
