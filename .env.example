# Google Gemini API (free tier - get key at https://aistudio.google.com)
GOOGLE_API_KEY=your-google-api-key

# Keep this stable in production so logins survive Render restarts
JWT_SECRET=change-me-to-a-long-random-string

# Database
# PostgreSQL/Supabase connection string: configure ONLY after verified migration.
# Store the real value as a protected hosting secret, never in Git.
DATABASE_URL=
# SQLite file path, used only without PostgreSQL or Turso.
# Use an absolute path OUTSIDE the checkout. Blank uses ~/.local/share/ai-code-mentor/.
DATABASE_PATH=
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Server
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Set to true only when SMTP below is working. If unset, verification
# is required only when all SMTP_* variables are present.
REQUIRE_EMAIL_VERIFICATION=true

# Email verification (optional for local/demo; required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional persistent database for free Render hosting.
# turso:// selects the Turso SDK; libsql:// selects the legacy libSQL SDK.
# Keep the token in hosting secrets; do not rewrite the URL scheme.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set true on ephemeral hosting with a configured remote database.
REQUIRE_REMOTE_DATABASE=false

# Public launch fails closed unless SMTP and verification are configured.
PUBLIC_LAUNCH=false
FRONTEND_URL=https://ai-code-mentor-frontend-iota.vercel.app
# Process-local network limits: deploy exactly one API worker.
API_REQUESTS_PER_MINUTE=120
AUTH_REQUESTS_PER_MINUTE=15
# Database-backed UTC daily limits include provider failures/retries.
ANALYSES_PER_USER_PER_DAY=20
ANALYSES_TOTAL_PER_DAY=200
# Generate with cryptography.fernet.Fernet.generate_key(); keep outside Git.
BACKUP_ENCRYPTION_KEY=

# Temporarily pause API traffic during a verified database cutover.
DATABASE_MAINTENANCE=false

# Brevo HTTPS transactional email (works without SMTP ports).
BREVO_API_KEY=
MAIL_FROM=
# Explicitly enable REQUIRE_EMAIL_VERIFICATION only after a delivery check.
