# Google Gemini API (free tier - get key at https://aistudio.google.com)
GOOGLE_API_KEY=your-google-api-key

# Keep this stable in production so logins survive Render restarts
JWT_SECRET=change-me-to-a-long-random-string

# Database
DATABASE_URL=sqlite:///code_mentor.db

# Server
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Set to true only when SMTP below is working. If unset, verification
# is required only when all SMTP_* variables are present.
REQUIRE_EMAIL_VERIFICATION=false

# Email verification (optional for local/demo; required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
